<section class="c-block c-feature-grid" data-module="feature-grid">
  <div class="c-block__inner">
    {% if eyebrow %}
      <span class="c-block__eyebrow">{{ eyebrow }}</span>
    {% endif %}

    {% if title %}
      <h2>{{ title }}</h2>
    {% endif %}

    {% if text %}
      <p>{{ text }}</p>
    {% endif %}

    <ul class="c-feature-grid__list">
      <li class="c-feature-item">
        <h3>Flexible layouts</h3>
        <p>Editors can rearrange large content sections without touching code.</p>
      </li>
      <li class="c-feature-item">
        <h3>Reusable patterns</h3>
        <p>Common content structures can be repeated and maintained in one place.</p>
      </li>
      <li class="c-feature-item">
        <h3>Modern stack</h3>
        <p>Clean Twig output, WordPress blocks, and SCSS work together without heavy JS.</p>
      </li>
    </ul>
  </div>
</section>
