{# -- Component Variables -- #}

{% set section = {
    layout: layout|default('bg-image'),
    headline: headline|default(post.title),
    image: image|default(post.thumbnail),
    video: params.video|default(null)
} %}

{# -- Component Template -- #}

<section class="c-banner is-{{ section.layout }}{{ blockAlign is not empty and section.layout in ['image', 'video'] ? ' u-' ~ blockAlign : '' }}">

    <article class="c-banner__text{{ textAlign ? ' u-' ~ textAlign : '' }}">

        {% if eyebrow %}
            <strong class="u-eyebrow">{{ eyebrow }}</strong>
        {% endif %}

        <h1 class="u-title">{{ section.headline }}</h1>

        {% if subheadline %}
            <h2 class="u-lead">{{ subheadline }}</h2>
        {% endif %}

        {% if text %}
            <div class="u-wysiwyg">
                {{ text }}
            </div>
        {% endif %}

        {% if buttons %}
            <div class="c-button-row">
                {% for button in buttons %}
                    {% include '_elements/button.twig' with {
                        params: {
                            url: button.button.url,
                            text: button.button.title,
                            target: button.button.target
                        }
                    } only %}
                {% endfor %}
            </div>
        {% endif %}
    </article>

    <figure class="c-banner__media{{ section.layout in ['image', 'video'] and aspectRatio is not empty and aspectRatio != 'none' ? ' u-ratio u-' ~ aspectRatio : '' }}"{% if section.layout in ['bg-image', 'bg-video'] %} style="opacity: {{ (100 - overlay) / 100 }}"{% endif %}>

        {% if section.layout in ['video', 'bg-video'] %}
            {% set moviePoster = videoThumb|default(post.thumbnail) %}
            <video width="{{ video.width }}" height="{{ video.height }}" class="c-banner__video" autoplay loop muted poster="{{ moviePoster.src('large') }}" preload="auto">
                <source src="{{ video.url }}" type="{{ video.mime_type }}">
                Your browser does not support the video tag.
            </video>

        {% elseif section.layout in ['image', 'bg-image'] %}

            {% include '_elements/picture.twig' with {
                params: {
                    src: section.image.src|default(null),
                    srcset: section.image.srcset|default(''),
                    sizes: section.image.sizes|default(null),
                    width: section.image.width|default(null),
                    height: section.image.height|default(null),
                    alt: section.image.alt|default(null),
                    webp: section.image.webp|default(null)
                },
                classes: 'c-media__image',
            } only %}

        {% endif %}

    </figure>

</section>
