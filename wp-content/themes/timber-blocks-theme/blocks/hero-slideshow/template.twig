{# -- Component Variables -- #}

{# {% set section = {} %} #}

{# -- Component Template -- #}

<section class="c-banner--slideshow{% if textAlign %} u-{{ textAlign }}{% endif %}" aria-label="Hero slideshow" id="{{ ID }}">
    {% for slide in slides %}
        <article class="c-banner--slideshow__slide c-banner{% if aspectRatio and aspectRatio != 'none' %} u-ratio u-{{ aspectRatio }}{% endif %}">
            <div class="c-banner__text">
                {% if slide.eyebrow %}
                    <strong class="u-eyebrow">{{ slide.eyebrow }}</strong>
                {% endif %}

                {% if loop.first %}
                    <h1 class="u-title">{{ slide.headline }}</h1>
                {% else %}
                    <h2 class="u-title">{{ slide.headline }}</h2>
                {% endif %}

                {% if slide.subheadline %}
                    <h3 class="u-lead">{{ slide.subheadline }}</h3>
                {% endif %}

                {% if slide.text %}
                    <div class="u-wysiwyg">
                        {{ slide.text }}
                    </div>
                {% endif %}

                {% if slide.buttons %}
                    <div class="c-button-row">
                        {% for button in slide.buttons %}
                            {% if button.button %}
                                {% include '_elements/button.twig' with {
                                    params: {
                                        url: button.button.url,
                                        text: button.button.title,
                                        target: button.button.target
                                    }
                                } only %}
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            <figure class="c-banner__media" style="--slide-overlay: {{ (slide.overlay|default(0)) / 100 }};">
                {% include '_elements/picture.twig' with {
                    params: {
                        src: slide.image.src|default(null),
                        srcset: slide.image.srcset|default(''),
                        sizes: slide.image.sizes|default(null),
                        width: slide.image.width|default(null),
                        height: slide.image.height|default(null),
                        alt: slide.image.alt|default(null),
                        webp: slide.image.webp|default(null)
                    },
                    classes: 'c-media__image'
                } only %}
            </figure>
        </article>
    {% endfor %}
</section>
