{# -- Component Variables -- #}

{# {% set var = value %} #}

{# -- Component Template -- #}

<section class="c-block c-hero c-hero--{{ template }}" id="{{ ID }}" data-module-hero>
  <div class="c-block__inner c-hero__inner">
    <div class="c-hero__content">
      {% if eyebrow %}
        <span class="c-hero__eyebrow">{{ eyebrow }}</span>
      {% endif %}

      {% if headline %}
        <h2 class="c-hero__title">{{ headline }}</h2>
      {% endif %}

      {% if text %}
        <p class="c-hero__text">{{ text }}</p>
      {% endif %}

      {% if buttonLink.url and buttonLink.title %}
        <div class="c-button-group">
          <a class="c-button c-button--primary" href="{{ buttonLink.url }}"{% if buttonLink.target %} target="{{ buttonLink.target }}" rel="noopener noreferrer"{% endif %}>{{ buttonLink.title }}</a>
        </div>
      {% endif %}
    </div>

    {% if media %}
      <div class="c-hero__media">{{ media|raw }}</div>
    {% endif %}
  </div>
</section>
