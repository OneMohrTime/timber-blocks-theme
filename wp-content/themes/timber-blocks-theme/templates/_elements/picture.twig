{# -- Component Variables -- #}

{% set options = {
    ratio: params.ratio ?? null,
    attr: params.attr ?? null,
    sizes: params.sizes|default('100vw'),
    lazy: lazyload ?? true,
    classes: classes ?? null
} %}

{# -- Component Template -- #}

{% if params.src %}

{# Frame can be set to relative/absolute image ratio-ing #}
<picture class="c-media
    {# Custom ratio #}
    {% if options.ratio %}u-ratio u-{{ options.ratio }}{% endif %}"
    {# Custom data-attributes #}
    {% if options.attr %}{{ options.attr }}{% endif %}
>

    {# img tag for browsers that do not support picture element #}
    {% if params.webp %}
        <source type="image/webp" srcset="{{ params.webp }}" sizes="{% if options.lazy %}auto, {% endif %}{{ options.sizes }}">
    {% endif %}

    <img src="{{ params.src }}"

        {# Alt text should never be empty, or contain tags, or be too long #}
        alt="{{ params.alt|default('') }}"

        {# Semantic HTML width & height values #}
        {% if params.width %}width="{{ params.width }}"{% endif %}
        {% if params.height %}height="{{ params.height }}"{% endif %}

        {# Default class #}
        class="c-media__image

        {# Additional custom classes #}
        {% if options.classes %}{{ options.classes|trim }}{% endif %}"

        {# Media query sizes #}
        sizes="{% if options.lazy %}auto, {% endif %}{{ options.sizes }}"

        {# Optimized image sizes #}
        {% if params.srcset %}srcset="{{ params.srcset }}"{% endif %}

        {# Lazyloaded by default #}
        {% if options.lazy %}loading="lazy" decoding="async"{% endif %}
    />

</picture>

{% else %}
<picture class="c-media">
    <img src="https://timber-blocks.ddev.site/wp-content/uploads/placeholder.jpg" alt="placeholder image" class="c-media__image" loading="lazy" />
</picture>

{% endif %}
